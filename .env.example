VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only credentials; never expose these with a VITE_ prefix.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_ACCESS_TOKEN=sbp_REPLACE_ME
# Optional direct PostgreSQL connection for migrations/SQL execution.
SUPABASE_DB_HOST=aws-0-REGION.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.PROJECT_REF
SUPABASE_DB_PASSWORD=REPLACE_ME
# Server-only key for scripts such as `npm run user:create`; never prefix this with VITE_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_ACCESS_TOKEN=
