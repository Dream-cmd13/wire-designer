{
  "name": "wire-harness-designer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "deploy": "node scripts/deploy.mjs",
    "deploy:check": "node scripts/deploy.mjs --dry-run",
    "quote:build": "node scripts/build-quote-function.mjs",
    "predev": "node scripts/prepare-dwg-viewer-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-dwg-viewer-assets.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck:app && npm run typecheck:server && npm run typecheck:functions",
    "typecheck:app": "tsc -b",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "typecheck:functions": "node scripts/typecheck-functions.mjs",
    "preview": "vite preview",
    "supabase:bootstrap-storage": "node scripts/bootstrap-storage.mjs",
    "supabase:upload-catalog-images": "node scripts/upload-catalog-images.mjs",
    "supabase:upload-dwg-drawings": "node scripts/upload-dwg-drawings.mjs",
    "supabase:upload-m12-pin-maps": "node scripts/upload-m12-pin-maps.mjs",
    "supabase:export-cost-seed": "node scripts/import-cost-analyses.mjs --export-sql",
    "supabase:verify-cost-analyses": "node scripts/verify-cost-analyses.mjs",
    "user:create": "node scripts/create-user.mjs",
    "test": "vitest run --exclude \".worktrees/**\" --exclude \".tmp/**\" --exclude \"tmp/**\" --exclude \"tests/e2e/**\"",
    "test:watch": "vitest --exclude \".worktrees/**\" --exclude \".tmp/**\" --exclude \"tmp/**\" --exclude \"tests/e2e/**\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mlightcad/libredwg-web": "^0.7.14",
    "@supabase/supabase-js": "^2.110.2",
    "@xyflow/react": "^12.11.0",
    "decimal.js": "^10.6.0",
    "html2canvas-pro": "^2.4.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@xmldom/xmldom": "^0.9.12",
    "deno": "2.9.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.6"
  }
}
